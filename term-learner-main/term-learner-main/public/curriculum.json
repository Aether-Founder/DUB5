          "id": "celbiologie",
          "name": "Hoofdstuk 1: Celbiologie",
          "learningSets": [
            {
              "id": "biologie-cel",
              "name": "Celbiologie - Termen",
              "pairs": [
                {
                  "term": "Cel",
                  "definition": "De kleinste levensfunctie-eenheid van alle organismen"
                },
                {
                  "term": "Celkern",
                  "definition": "Het centrale deel van een eukaryotische cel dat het DNA bevat"
                },
                {
                  "term": "Mitochondrion",
                  "definition": "Het energieproducerende organel van de cel (krachtcentrale)"
                },
                {
                  "term": "Ribosoom",
                  "definition": "Een celstructuur waar eiwitten worden gemaakt"
                },
                {
                  "term": "Celmembraan",
                  "definition": "De buitenste laag van een cel die stoffen reguleert"
                },
                {
                  "term": "Lysosoom",
                  "definition": "Een organel met enzymen dat afvalstoffen afbreekt"
                },
                {
                  "term": "Golgi-apparaat",
                  "definition": "Verpakt en sorteert eiwitten voor transport"
                },
                {
                  "term": "Endoplasmatisch reticulum",
                  "definition": "Een netwerk van membranen betrokken bij eiwitsynthese"
                }
              ]
            }
          ]
        }
      ]
