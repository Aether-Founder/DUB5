{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dub5.design-system/tokens.json",
  "title": "DUB5 Design Tokens",
  "description": "Machine-readable design tokens for the DUB5 design system. These correspond to the canonical rules documented in DESIGN.md.",
  "version": "1.0.0",
  "tokens": {
    "color": {
      "background": {
        "primary": "#0b1150",
        "secondary": "#050833",
        "tertiary": "#01030f"
      },
      "surface": {
        "glass": "rgba(9, 13, 38, 0.62)",
        "glassHover": "rgba(13, 19, 50, 0.72)",
        "glassBlur": "blur(16px) saturate(160%)"
      },
      "text": {
        "primary": "rgb(226, 240, 255)",
        "secondary": "rgba(226, 240, 255, 0.60)",
        "tertiary": "rgba(226, 240, 255, 0.38)"
      },
      "line": {
        "default": "rgba(224, 242, 254, 0.16)",
        "strong": "rgba(224, 242, 254, 0.30)"
      },
      "accent": {
        "games": "#4cc9f0",
        "tools": "#a78bfa",
        "study": "#34d399",
        "hacks": "#fb7185",
        "guides": "#fbbf24"
      },
      "status": {
        "badge1": "#ff5a5f",
        "badge2": "#d81f2a"
      }
    },
    "typography": {
      "fontFamily": {
        "display": "'DM Serif Display', Georgia, serif",
        "ui": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
      },
      "fontSize": {
        "display": {
          "desktop": "8rem",
          "mobile": "4.5rem"
        },
        "detailTitle": "4.5rem",
        "cardTitle": "0.98rem",
        "cardDescription": "0.83rem",
        "body": "1rem"
      },
      "lineHeight": {
        "body": 1.5,
        "heading": 1.2
      },
      "letterSpacing": {
        "default": "normal"
      }
    },
    "spacing": {
      "scale": {
        "0.22": "0.22rem",
        "0.25": "0.25rem",
        "0.28": "0.28rem",
        "0.3": "0.3rem",
        "0.35": "0.35rem",
        "0.4": "0.4rem",
        "0.5": "0.5rem",
        "0.65": "0.65rem",
        "0.68": "0.68rem",
        "0.7": "0.7rem",
        "0.75": "0.75rem",
        "0.8": "0.8rem",
        "0.85": "0.85rem",
        "1": "1rem",
        "1.15": "1.15rem",
        "1.5": "1.5rem",
        "2": "2rem",
        "2.1": "2.1rem",
        "2.5": "2.5rem",
        "3": "3rem",
        "3.5": "3.5rem",
        "4": "4rem",
        "5": "5rem",
        "6": "6rem",
        "7.5": "7.5rem"
      },
      "container": {
        "desktop": "7.5rem 2rem 3rem",
        "mobile": "6.5rem 1.25rem 2rem"
      },
      "gridGap": "0.85rem"
    },
    "radius": {
      "pill": "999px",
      "panel": "18px",
      "chip": "12px",
      "badge": "7px"
    },
    "border": {
      "width": "1px",
      "color": {
        "default": "rgba(224, 242, 254, 0.16)",
        "strong": "rgba(224, 242, 254, 0.30)"
      }
    },
    "shadow": {
      "glass": "0 18px 40px -26px rgba(0, 0, 0, 1)",
      "glassInset": "inset 0 1px 0 rgba(255, 255, 255, 0.09)"
    },
    "opacity": {
      "hover": 1,
      "inactive": 0.6
    },
    "motion": {
      "duration": {
        "hover": "300ms",
        "enter": "550ms",
        "topbarScroll": "420ms",
        "headerRule": "1300ms"
      },
      "easing": {
        "hover": "ease-in-out",
        "enter": "cubic-bezier(0.22, 1, 0.36, 1)",
        "scroll": "cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "transform": {
        "hoverLift": "translateY(-2px)",
        "iconChipHover": "scale(1.05)",
        "titleHover": "translateX(2px)",
        "arrowHover": "translate(2px, -2px)",
        "activeButton": "scale(0.9)"
      }
    },
    "breakpoint": {
      "hideDescriptions": "560px",
      "singleColumn": "600px",
      "mobile": "768px",
      "tablet": "900px"
    },
    "zIndex": {
      "content": 10,
      "topbar": 50,
      "overlay": 100
    },
    "layout": {
      "container": {
        "maxWidth": "1400px"
      },
      "grid": {
        "minWidth": "340px"
      }
    }
  }
}
